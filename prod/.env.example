# ==============================================================================
# Production Environment - Optimized for 1 Core CPU / 1GB RAM / 20GB Disk
# ==============================================================================

# Docker Images (Thay đổi theo GitHub Username của bạn hoặc giữ nguyên nếu dùng Docker Hub / Local)
BACKEND_IMAGE=ghcr.io/videoveo3pro-debug/pia-backend:latest
WORKER_IMAGE=ghcr.io/videoveo3pro-debug/pia-worker:latest

# PIA Account Storage
PIA_ACCOUNT_STORAGE_ENABLED=true

# Số lượng worker kích hoạt (30 Worker cho 1 vCPU với 4GB Swap)
WORKER_COUNT=30
MAX_WORKER_COUNT=30

# Cấu hình vùng/quốc gia khởi động cho từng worker (random hoặc tên region trong `piactl get regions`)
WORKER_1_COUNTRY=random
WORKER_2_COUNTRY=random
WORKER_3_COUNTRY=random
WORKER_4_COUNTRY=random
WORKER_5_COUNTRY=random
WORKER_6_COUNTRY=random
WORKER_7_COUNTRY=random
WORKER_8_COUNTRY=random
WORKER_9_COUNTRY=random
WORKER_10_COUNTRY=random
WORKER_11_COUNTRY=random
WORKER_12_COUNTRY=random
WORKER_13_COUNTRY=random
WORKER_14_COUNTRY=random
WORKER_15_COUNTRY=random
WORKER_16_COUNTRY=random
WORKER_17_COUNTRY=random
WORKER_18_COUNTRY=random
WORKER_19_COUNTRY=random
WORKER_20_COUNTRY=random
WORKER_21_COUNTRY=random
WORKER_22_COUNTRY=random
WORKER_23_COUNTRY=random
WORKER_24_COUNTRY=random
WORKER_25_COUNTRY=random
WORKER_26_COUNTRY=random
WORKER_27_COUNTRY=random
WORKER_28_COUNTRY=random
WORKER_29_COUNTRY=random
WORKER_30_COUNTRY=random

PIA_LOGIN_ON_STARTUP=true
PIA_CONNECT_ON_STARTUP=true

# Tự động phát hiện pool worker
PROXY_WORKERS=auto

# Thông tin xác thực SOCKS5 Gateway (Client kết nối vào cổng này)
PROXY_HOST=0.0.0.0
PROXY_PORT=1087
SOCKS5_USERNAME=proxy_user
SOCKS5_PASSWORD=proxy_password

# Port cho Backend API quản lý
API_PORT=8007
HAPROXY_STATS_PORT=8411

# ==============================================================================
# Tối ưu hóa điều phối & Watchdog cho 1 Core CPU (Tránh nghẽn CPU)
# ==============================================================================
# Số worker tối thiểu luôn ở trạng thái READY khi thực hiện rotate
MIN_READY_WORKERS=6

# Cấu hình tự động xoay IP & Giới hạn tuổi thọ IP tối đa (giây)
AUTO_ROTATE_ENABLED=true
AUTO_ROTATE_INTERVAL_MIN_SECONDS=30
AUTO_ROTATE_INTERVAL_MAX_SECONDS=50
AUTO_ROTATE_MAX_UPTIME_SECONDS=50

# Tần suất kiểm tra sức khoẻ định kỳ và thực thi xoay IP (giây)
HEALTH_INTERVAL_SECONDS=10
WATCHDOG_INTERVAL_SECONDS=15

# Thời gian timeout và delay cho các lệnh CLI PIA
CLI_COMMAND_TIMEOUT_SECONDS=25
CLI_STATUS_TIMEOUT_SECONDS=25
CLI_STATUS_SETTLE_SECONDS=6
PIA_CLI_LOCK_WAIT_SECONDS=8

# Tự phục hồi worker nếu gặp sự cố
WORKER_RECOVERY_RESTART_AFTER_FAILURES=3
WORKER_RECOVERY_DOCKER_RESTART_AFTER_FAILURES=5
