# Optional image overrides. Leave empty to build locally with `docker compose up --build`.
BACKEND_IMAGE=
WORKER_IMAGE=

# PIA CLI SOCKS5 multi-worker gateway.
# Do not put PIA account passwords in .env. Login through the API/UI, or
# store them in credentials/pia_account_1 as two lines: username, then password.
PIA_ACCOUNT_STORAGE_ENABLED=true

# Worker mode:
# 8  = worker 1-8 active.
# 20 = worker 1-20 active (20 unique IPs).
WORKER_COUNT=20
MAX_WORKER_COUNT=20

# Worker startup targets should match `piactl get regions` names or codes.
WORKER_1_COUNTRY=random
WORKER_2_COUNTRY=random
WORKER_3_COUNTRY=random
WORKER_4_COUNTRY=random
WORKER_5_COUNTRY=random
WORKER_6_COUNTRY=random
WORKER_7_COUNTRY=random
WORKER_8_COUNTRY=random
WORKER_9_COUNTRY=random
WORKER_10_COUNTRY=random
WORKER_11_COUNTRY=random
WORKER_12_COUNTRY=random
WORKER_13_COUNTRY=random
WORKER_14_COUNTRY=random
WORKER_15_COUNTRY=random
WORKER_16_COUNTRY=random
WORKER_17_COUNTRY=random
WORKER_18_COUNTRY=random
WORKER_19_COUNTRY=random
WORKER_20_COUNTRY=random
PIA_LOGIN_ON_STARTUP=true
PIA_CONNECT_ON_STARTUP=true

# Worker registry used by backend. Format:
# id:service_host:control_port:socks_port[:startup_country[:container_name[:token_slot]]]
PROXY_WORKERS=auto

# Fixed external SOCKS5 gateway. Other apps only use this proxy.
SOCKS5_USERNAME=proxy_user
SOCKS5_PASSWORD=proxy_password
PROXY_HOST=127.0.0.1
PROXY_PORT=1087
SOCKS5_PORT=1080
PROXY_CONTROL_PORT=9000
PROXY_CONTROL_TOKEN=
HAPROXY_STATS_PORT=8411
HAPROXY_RUNTIME_SOCKET=/run/haproxy/admin.sock

# Smooth failover/rotate policy.
MIN_READY_WORKERS=3
GATEWAY_TARGET_FAILOVER_SECONDS=10
MIN_SECONDS_BETWEEN_ROTATIONS=5
AUTO_ROTATE_ENABLED=true
AUTO_ROTATE_INTERVAL_MIN_SECONDS=30
AUTO_ROTATE_INTERVAL_MAX_SECONDS=50
AUTO_ROTATE_MAX_UPTIME_SECONDS=50
AUTO_ROTATE_MIN_READY_WORKERS=4
AUTO_ROTATE_MAX_PARALLEL=4
AUTO_ROTATE_MAX_PARALLEL_PER_TOKEN=2
AUTO_ROTATE_TARGET_ATTEMPTS=2
AUTO_ROTATE_CONNECT_TIMEOUT_SECONDS=20
AUTO_ROTATE_PAUSE_READY_THRESHOLD=4
CONNECT_TIMEOUT_SECONDS=60
IP_CHECK_TIMEOUT_SECONDS=4
IP_CHECK_INTERVAL_SECONDS=1.2
PIA_CONNECT_MAX_ATTEMPTS=3
PIA_LOGIN_TIMEOUT_SECONDS=120
CLI_COMMAND_TIMEOUT_SECONDS=30
CLI_STATUS_TIMEOUT_SECONDS=30
CLI_STATUS_SETTLE_SECONDS=4
CLI_STATUS_LOOP_INTERVAL_SECONDS=30
CLI_CONNECT_TIMEOUT_SECONDS=90
REQUIRE_NEW_IP_ON_CHANGE=true
READY_SUCCESS_THRESHOLD=1
READY_FAILURE_THRESHOLD=3
READY_VERIFIED_GRACE_SECONDS=30
READY_PROXY_FAILURE_FAIL_FAST=true
ROTATE_PROMOTE_STABLE_SECONDS=4

# Backend web UI/API.
API_PORT=8007
MASK_PROXY_PASSWORD_IN_STATUS=false
API_AUTH_ENABLED=false
API_TOKEN=

# Stable defaults. Change only if needed.
PIA_COUNTRY_SOURCE=env
PIA_COUNTRIES=Singapore,Japan,United States,Germany,United Kingdom,Canada,Netherlands,Australia,France,Sweden,Italy,Spain,Poland,Switzerland,Hong Kong,New Zealand,Brazil,Mexico,Belgium,Austria
PIA_DISCOVER_COUNTRIES=false
PIA_PROTOCOL=auto
PIA_NETWORK_LOCK=false
AUTO_RECONNECT=true

# Worker watchdog/self-healing. Keeps all configured workers active when possible.
HEALTH_INTERVAL_SECONDS=8
WORKER_RECOVERY_ENABLED=true
WORKER_RECOVERY_CONNECT_AFTER_FAILURES=1
WORKER_RECOVERY_RESTART_AFTER_FAILURES=3
WORKER_RECOVERY_DOCKER_RESTART_AFTER_FAILURES=5
WORKER_RECOVERY_COOLDOWN_SECONDS=15
WORKER_RECOVERY_VERIFY_SECONDS=12
WORKER_RECOVERY_CONNECT_MAX_ATTEMPTS=1
WORKER_RECOVERY_MAX_PARALLEL=4
DOCKER_RECOVERY_ENABLED=true
DOCKER_SOCKET_PATH=/var/run/docker.sock
TARGET_FAILURE_COOLDOWN_ENABLED=true
TARGET_FAILURE_COOLDOWN_SECONDS=1800
TARGET_FAILURE_COOLDOWN_THRESHOLD=1
TARGET_BAD_FAILURE_THRESHOLD=4
TARGET_BAD_SUCCESS_RATE_THRESHOLD=0.25
TARGET_AVOID_BAD=true
SERVER_TARGET_AVOID_BAD=true
